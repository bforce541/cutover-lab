# Defaults: sample fixture and independent DuckDB candidate.
# REHEARSAL_DATA=full
# REHEARSAL_TARGET=local

# Databricks Free Edition · use SQL Warehouses → Connection details.
# DATABRICKS_SERVER_HOSTNAME=
# DATABRICKS_HTTP_PATH=
# DATABRICKS_CATALOG=workspace
# DATABRICKS_SCHEMA=migration_rehearsal
# DATABRICKS_DELTA_VERSION_2024_12=0
# DATABRICKS_DELTA_VERSION_2025_01=0
# REHEARSAL_SYSTEM_TRUST=1

# BigQuery Sandbox · use Application Default Credentials.
# BIGQUERY_PROJECT=
# BIGQUERY_DATASET=migration_rehearsal
# BIGQUERY_LOCATION=US
